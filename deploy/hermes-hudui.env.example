# Configuración de hermes-hudui. Este archivo NO contiene secretos.
# Copiado a /etc/hermes-hudui/hermes-hudui.env (0640 root:hermes).

# El HUD no tiene autenticación propia: escucha solo en loopback y se publica
# a través de nginx (TLS + auth). No cambiar a 0.0.0.0 sin un proxy delante.
HUD_HOST=127.0.0.1
HUD_PORT=3001

# Directorio de datos del agente Hermes (solo lectura para el HUD).
HERMES_HOME=/home/hermes/.hermes

# Modo offline: bloquea (403) las acciones que contactarían hosts externos:
# actualizar hermes, instalar/actualizar plugins, gateway, chat y cron con LLMs.
HERMES_HUD_OFFLINE=1
